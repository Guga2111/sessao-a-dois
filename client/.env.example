# Base URL da API (host puro, sem /api e sem porta).
# As chamadas axios ja incluem o prefixo /api/... e o SockJS usa ${VITE_API_URL}/ws.

# Desenvolvimento local
VITE_API_URL=http://localhost:8080

# Producao (copie para client/.env.production, que e ignorado pelo git):
# VITE_API_URL=https://sessaoadois.luisgosampaio.com
