# Base URL da API (host puro, sem /api e sem barra final).
# As chamadas axios ja incluem o prefixo /api/... e o SockJS usa ${VITE_API_URL}/ws.

# Desenvolvimento local: OBRIGATORIO.
# A pagina roda em localhost:5173 e a API em localhost:8080 — origens diferentes,
# entao a URL precisa ser absoluta.
VITE_API_URL=http://localhost:8080

# Producao: NAO definir.
#
# A SPA e a API sao same-origin (o nginx faz proxy de /api e /ws no mesmo dominio),
# entao o valor correto e "vazio" — URL relativa. O codigo trata a ausencia da
# variavel com `?? ""` (ver client/src/vite-env.d.ts), e o build do CD roda sem ela
# de qualquer forma: `client/.env.production` e ignorado pelo git e nao existe no
# runner do GitHub Actions.
#
# Definir VITE_API_URL=https://sessaoadois.luisgosampaio.com aqui nao quebra nada,
# mas so tem efeito em build feito da maquina de quem criou o arquivo — o que faz o
# bundle do deploy manual divergir do bundle do CD. Preferir nao ter o arquivo.
