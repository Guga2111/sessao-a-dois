# Copie este arquivo para .env na raiz do repo antes de rodar o docker compose.
# O docker compose carrega .env automaticamente do mesmo diretorio do arquivo
# compose (docker-compose-dev.yml ou docker-compose-prod.yml).
#
# ATENCAO: preencha com valores REAIS apenas no .env (que e git-ignorado).
# NUNCA coloque segredos reais neste .env.example - apenas placeholders.

# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL (usado por docker-compose-prod.yml para criar o
# banco e por DB_URL/DB_USER/DB_PASSWORD da API que apontam para o servico db).
# ---------------------------------------------------------------------------
POSTGRES_DB=sessao
POSTGRES_USER=sessao
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ---------------------------------------------------------------------------
# Seguranca / JWT
# ---------------------------------------------------------------------------
# Segredo de assinatura do JWT (HS256 exige no minimo 32 bytes). Gere um valor
# aleatorio, ex.: `openssl rand -base64 48`.
JWT_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-bytes
# Validade do token em dias (opcional; default 7 se ausente).
JWT_EXPIRATION_DAYS=7

# ---------------------------------------------------------------------------
# CORS / Dominio
# ---------------------------------------------------------------------------
# Origem do frontend permitida pelo backend. Em producao, o dominio publico.
CORS_ALLOWED_ORIGIN=https://sessaoadois.luisgosampaio.com
# Dominio publico do app (referencia para Nginx/certbot e config do frontend).
DOMAIN=sessaoadois.luisgosampaio.com

# ---------------------------------------------------------------------------
# TMDB (obrigatoria - com.app.media.TmdbConfig falha ao subir sem ela).
# Gere em https://www.themoviedb.org/settings/api - use o "API Read Access
# Token (v4 auth)".
# ---------------------------------------------------------------------------
TMDB_API_KEY=cole-aqui-seu-tmdb-api-read-access-token

# ---------------------------------------------------------------------------
# Porta da API publicada no host (o Nginx faz proxy para ela). Default 8085.
# ---------------------------------------------------------------------------
API_PORT=8085
