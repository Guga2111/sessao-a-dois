# Copie este arquivo para .env na raiz do repo antes de rodar o deploy.
# ATENCAO: preencha com valores REAIS apenas no .env (que e git-ignorado).
# NUNCA coloque segredos reais neste .env.example - apenas placeholders.

# ---------------------------------------------------------------------------
# Banco de dados Supabase (connection pooler, porta 6543, modo Transaction)
# Copie do painel Supabase > Project Settings > Database > Connection string
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USER=postgres.seu-project-ref
DB_PASSWORD=troque-por-sua-senha-supabase

# ---------------------------------------------------------------------------
# Seguranca / JWT
# ---------------------------------------------------------------------------
# Segredo de assinatura do JWT (HS256 exige no minimo 32 bytes). Gere um valor
# aleatorio, ex.: `openssl rand -base64 48`.
JWT_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-bytes

# ---------------------------------------------------------------------------
# CORS / Dominio
# ---------------------------------------------------------------------------
# Origem do frontend permitida pelo backend.
CORS_ALLOWED_ORIGIN=https://sessaoadois.luisgosampaio.com

# ---------------------------------------------------------------------------
# TMDB (obrigatoria - com.app.media.TmdbConfig falha ao subir sem ela).
# Gere em https://www.themoviedb.org/settings/api - use o "API Read Access
# Token (v4 auth)".
# ---------------------------------------------------------------------------
TMDB_API_KEY=cole-aqui-seu-tmdb-api-read-access-token

# ---------------------------------------------------------------------------
# Deploy (usadas pelo scripts/deploy.sh)
# ---------------------------------------------------------------------------
SSH_HOST=ip-da-vps
SSH_USER=root
SSH_PORT=22
API_PORT=8085
