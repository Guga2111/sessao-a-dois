# Copie este arquivo para .env na raiz do repo antes de rodar
# docker compose -f docker-compose-dev.yml up -d
# (o docker compose carrega .env automaticamente do mesmo diretorio do arquivo compose)

# API Key/Token do TMDB (obrigatoria - com.app.media.TmdbConfig falha ao subir sem ela).
# Gere em https://www.themoviedb.org/settings/api - use o "API Read Access Token (v4 auth)".
TMDB_API_KEY=
